# ---------------------------------------------------------------
# .gitignore
# Retail Sales ETL & Analytics Platform
# ---------------------------------------------------------------

# ── Python cache & bytecode ──────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# ── Virtual environments ─────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Environment variables (contains DB passwords) ────────────
# IMPORTANT: .env is NEVER committed. Use .env.example as template.
.env

# ── IDE / Editor folders ─────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Logs (auto-generated on every pipeline run) ──────────────
logs/

# ── Processed data ───────────────────────────────────────────
data/processed/*
!data/processed/retail_sales_cleaned.csv
!data/processed/.gitkeep

# ── OS-generated files ───────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Temporary and backup files ───────────────────────────────
*.bak
*.tmp
*.swp
*.swo
*~

# ── Database files ───────────────────────────────────────────
*.sqlite
*.sqlite3
*.db

# ── Streamlit cache ──────────────────────────────────────────
.streamlit/

# ── Pytest / test artifacts ──────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Build artifacts ──────────────────────────────────────────
dist/
build/
*.egg-info/
