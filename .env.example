# .env.example
# ---------------------------------------------------------------
# Retail Sales ETL & Analytics Pipeline
#
# This file is a TEMPLATE. It shows which environment variables
# the application expects.
#
# HOW TO USE:
#   1. Copy this file and rename the copy to  .env
#   2. Fill in your actual PostgreSQL credentials in .env
#   3. Never commit .env to version control (it is in .gitignore)
# ---------------------------------------------------------------

# Hostname where PostgreSQL is running.
# Use "localhost" if the database is on the same machine.
DB_HOST=localhost

# PostgreSQL port (default is 5432, change only if you customised it)
DB_PORT=5432

# Name of the database to connect to.
# Create this database in PostgreSQL before running load.py
DB_NAME=retail_sales_db

# PostgreSQL username
DB_USER=postgres

# PostgreSQL password for the above user
DB_PASSWORD=your_password
